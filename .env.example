# Copy this file to .env and fill in your own values. Never commit .env.

# --- Live listings (optional) -------------------------------------------
# Free key from https://scrappa.co (500 free credits/month after email verification).
# Leave empty to run with the historical dataset only.
SCRAPPA_API_KEY=
# 99acres city token(s), comma separated. Live comparables are shown only for
# the training city (Bengaluru), so "bangalore" is the useful default.
LIVE_CITIES=bangalore
# Skip API calls if the last successful refresh is newer than this.
MIN_REFRESH_INTERVAL_MINUTES=360
# Background refresh inside the web app every N hours (0 = off).
AUTO_REFRESH_HOURS=0
# Data newer than this is labelled "live", older is labelled "cached".
LIVE_FRESHNESS_HOURS=24

# --- Mumbai listings (optional) ------------------------------------------
# Apify API token: https://console.apify.com/settings/integrations
# The free Apify plan includes US$5 of credit a month (about 4,900 listings
# with the Housing.com scraper). Used only by: python apify_fetcher.py
APIFY_TOKEN=
# Listings requested per fetch (each costs about US$0.001).
APIFY_MAX_RESULTS=1000
# Give up waiting for a scraper run after this many seconds.
APIFY_TIMEOUT_SECONDS=900

# Password for the "Refresh now" admin button on the website.
# Leave empty to hide the button. Use a long random value.
REFRESH_TOKEN=

# --- Server ------------------------------------------------------------------
PORT=8000
